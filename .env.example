# Copy this file to .env and fill in your values

# Backend
DATABASE_URL=
API_V1_PREFIX=
DEBUG=
# Comma-separated allowed frontend origins (include production URLs)
# Example: CORS_ORIGINS_CSV=https://road-report-ai-frontend.vercel.app,https://www.yourdomain.com
CORS_ORIGINS_CSV=

# External APIs
GOOGLE_MAPS_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_USER_AGENT=
WEATHER_TIMEOUT_SECONDS=

# ML model runtime
MODEL_FILE_PATH=app/services/logistic_regression_model.pth
FEATURE_COLUMNS_PATH=app/services/feature_columns.pkl
MODEL_VERSION=log-reg-v1
